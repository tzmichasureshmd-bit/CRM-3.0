# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── FastAPI Backend ────────────────────────────────────────────
# FIX-002: JWT_SECRET must match the backend JWT_SECRET exactly.
# The Next.js server uses this to verify FastAPI-issued JWTs on /api/v3/* routes.
# NEVER expose this in NEXT_PUBLIC_* variables.
# Generate with: openssl rand -hex 32
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
JWT_SECRET=your-jwt-secret-must-match-backend-exactly

# ── Google OAuth ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── WhatsApp Business API ──────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# ── Email Integration (Gmail/Outlook) ──────────────────────────
# See docs/EMAIL_INTEGRATION_SETUP.md for step-by-step guide
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-16-char-app-password
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_FROM_NAME=Your Company Name
EMAIL_FROM_ADDRESS=your-email@gmail.com

# ── AI Providers ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Encryption ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=your-32-char-aes-256-key-here!!!

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CRM 3.0

# ── Cron Job Security ──────────────────────────────────────────
# Generate a secure random string for production
# Example: openssl rand -hex 32
CRON_SECRET=your-cron-secret-min-32-chars

# ── Telegram Bot API ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
