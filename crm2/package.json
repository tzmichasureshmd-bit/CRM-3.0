{
  "name": "wacrm",
  "version": "0.8.0",
  "private": true,
  "description": "Self-hostable CRM template for WhatsApp built on Next.js and Supabase — shared inbox, contacts, sales pipelines, broadcasts, and no-code automations.",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/ArnasDon/wacrm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArnasDon/wacrm.git"
  },
  "bugs": {
    "url": "https://github.com/ArnasDon/wacrm/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "nextjs",
    "supabase",
    "automation",
    "broadcast",
    "self-hosted",
    "template"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-whatsapp-embedded-signup.mjs",
    "native:icons": "node scripts/generate-native-assets.mjs",
    "android:sync": "cap sync android",
    "android:build": "node scripts/build-android.mjs",
    "windows:build": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.107.0",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.22.0",
    "next": "16.2.6",
    "next-intl": "^4.13.2",
    "opus-recorder": "^8.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-whatsapp-embedded-signup": "^2.0.0",
    "recharts": "^3.9.2",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip-address": "^10.1.1",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.25",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6"
  }
}
