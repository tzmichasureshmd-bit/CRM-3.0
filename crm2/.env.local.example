# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=054ebbd6b523cb36b6ce786aa3532ee00c27686fa5cf409948e81e5b508f24fb
# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=a25ab21211db675c2a23bdceddd68332

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong — e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# ------------------------------------------------------------------
# Meta Lead Ads (Facebook + Instagram) — Settings → Meta Leads
# ------------------------------------------------------------------
# Combine a real/non-development Facebook app. OAuth works with a dev-mode
# app but only admins/developers/testers of that app can connect — for an
# unbranded login you must add yourself (or users) as an app tester.
#
# Required:
#   META_APP_ID        — App Settings → Basic → App ID
#   META_APP_SECRET    — App Settings → Basic → App Secret (also verifies
#                        the HMAC-SHA256 signature on inbound lead webhooks)
#   NEXT_PUBLIC_SITE_URL — canonical origin, e.g. https://crm.example.com
#
# Recommended (any long random string, same storage as the WhatsApp one):
#   META_VERIFY_TOKEN  — instance-level fallback for the leadgen webhook
#                        GET verification challenge below.
#
# Register these two URLs in Meta for Developers → App → App review for
# the Lead Ads product → Webhooks config (production deployment):
#   OAuth redirect URI : <NEXT_PUBLIC_SITE_URL>/api/meta/leads/connect/callback
#   Webhook URL        : <NEXT_PUBLIC_SITE_URL>/api/meta/leads/webhook
#   Verify token       : the value of META_VERIFY_TOKEN (or your per-account token)
#
# App permissions the OAuth flow requests (App Review → Permissions and
# Features): pages_show_list, pages_manage_metadata, leads_retrieval,
# ads_management.
# META_VERIFY_TOKEN=your-verify-token

# Facebook Login for Business configuration ID used by the "Connect
# WhatsApp Business App" (Meta Embedded Signup v4) flow in
# Settings → WhatsApp. Create it in Meta for Developers → App → WhatsApp
# → Embedded Signup (v4). The app must have the WhatsApp product and
# Facebook Login for Business configured, with your domain listed under
# Allowed Domains and your OAuth redirect URIs under Valid OAuth Redirect
# URIs (see docs/whatsapp-embedded-signup.md). This is OPTIONAL: the
# manual Cloud API connection works without it.
# META_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# Optional public override for the exact OAuth redirect URI the Embedded
# Signup popup uses. When unset the current page origin + pathname is used
# (e.g. http://localhost:3000/settings in dev). Set this in production so
# the redirect URI is pinned and can be registered verbatim under Facebook
# Login → Valid OAuth Redirect URIs. Public value (embedded in the client).
# NEXT_PUBLIC_META_EMBEDDED_SIGNUP_REDIRECT_URI=https://crm.example.com/settings

# Client-side Embedded Signup values consumed by the Settings → WhatsApp
# "Connect Business App" popup.  These are public (not secrets) but must
# be set at build time for the Meta popup to render.  Omitting them causes
# the popup to degrade ("config ID invalid" / "App unavailable").
# NEXT_PUBLIC_META_APP_ID=your-meta-app-id
# NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# Optional instance-level fallback for the /api/whatsapp/webhook GET verify
# challenge. Per-account verify tokens stored in whatsapp_config still take
# precedence; setting this just makes Meta's dashboard verification succeed
# before any config row exists. Any long random string.
# META_VERIFY_TOKEN=your-verify-token

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ============================================================
# SUPER ADMIN — comma-separated list of authorized email addresses
# ============================================================
# Only these emails can access /admin (must also have platform_role = "super_admin" in DB).
SUPER_ADMIN_EMAILS=tzmicha.sureshmd@gmail.com,nsaikumarrr@gmail.com 

# ============================================================
# LEAD ALERTS — Super Admin two-person "new lead" email notifications
# ============================================================
# Automatic "New Lead Received" emails are sent through Resend's REST
# API (no SDK needed). Create an API key at resend.com → API Keys.
# Without this var nothing is sent; the Lead Alerts page surfaces a
# clear "not configured" state.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#
# The From address/name and the two notification recipients are stored
# in platform_lead_notification_settings and edited under Super Admin →
# Settings → Lead Alerts. The From domain must be verified with Resend. 

# ------------------------------------------------------------------
# X (Twitter) integration — Settings → Integrations → X
# ------------------------------------------------------------------
# Create an app at developer.x.com. Under "User authentication settings"
# enable OAuth 2.0 with PKCE, set the callback URL to:
#   <NEXT_PUBLIC_SITE_URL>/api/x/callback
# Required scopes: tweet.read tweet.write users.read offline.access
#
# NOTE: DMs (dm.read / dm.write) require X Pro ($5,000/mo). The Free
# tier supports tweet publishing and timeline reading only.
#
# X_CLIENT_ID=your-x-oauth2-client-id
# X_CLIENT_SECRET=your-x-oauth2-client-secret

# ------------------------------------------------------------------
# Threads integration — Settings → Integrations → Threads
# ------------------------------------------------------------------
# Create a Meta app at developers.facebook.com and add the Threads product.
# Set the OAuth redirect URI to:
#   <NEXT_PUBLIC_SITE_URL>/api/threads/callback
# Required scopes: threads_basic threads_content_publish threads_manage_replies
#
# NOTE: Threads has no DM API. This integration supports publishing posts
# and managing replies only.
#
# THREADS_APP_ID=your-threads-app-id
# THREADS_APP_SECRET=your-threads-app-secret
